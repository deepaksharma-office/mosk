<script type="module" src="{{ 'section-testimonial-images.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_st = section.settings
  assign theme_st = settings
  assign scroll_animation = theme_st.scroll_animation
  if section_st.section_width == 'fix_width'
    assign section_width = 'container'
  elsif section_st.section_width == 'full_width'
    assign section_width = 'full-width'
  else
    assign section_width = 'fluid_container'
  endif
  assign animate_delay = 25

  assign heading = section_st.title
  assign text_alignment = section_st.text_alignment
  assign drawn_underline = section_st.drawn_underline
  assign drawn_underline_type = section_st.drawn_underline_type
  assign drawn_underline_color = section_st.drawn_underline_color
  if drawn_underline
    assign scroll_animation = 'disable'
  endif
  assign heading_size = section_st.heading_size

  assign header_size = ''
  if heading_size == 'small'
    assign header_size = 'h3'
  elsif heading_size == 'large'
    assign header_size = 'h1'
  endif

  assign show_pagination = section_st.show_pagination
  assign show_navigation = section_st.show_navigation
  assign show_slide_counter = section_st.show_slide_counter
  assign slide_auto_change = section_st.slide_auto_change
  assign change_slide_every = section_st.change_slide_every
  assign content_alignment = section_st.content_alignment

  assign padding_content_inline = section_st.padding_content_inline
  assign padding_content_block = section_st.padding_content_block
  assign padding_content_class = ''
  if padding_content_inline > 20
    assign padding_content_class = padding_content_class | append: ' px-custom'
  else
    assign padding_content_class = padding_content_class | append: ' x-min-value'
  endif
  if padding_content_block > 24
    assign padding_content_class = padding_content_class | append: ' py-custom'
  else
    assign padding_content_class = padding_content_class | append: ' y-min-value'
  endif
%}

{% stylesheet %}
  @media (max-width: 767.98px) {
    .section-image-with-text-carousel .py-custom {
      padding-block: calc(var(--padding-block) * 0.32px);
    }
  }

  .section-image-with-text-carousel testimonial-images-slide {
    width: calc(100% + 2 * var(--sp-2));
    margin-inline: calc(-1 * var(--sp-2));
  }

  .section-image-with-text-carousel .swiper-footer .swiper-pagination {
    width: auto;
  }

  .section-image-with-text-carousel .swiper-footer .swiper-pagination-progressbar {
    width: 13rem;
  }
{% endstylesheet %}

{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}

{%- render 'section-divider', position: 'top', style: section_st.divider_top, color_scheme: section_st.color_scheme, enabled: section_st.show_divider -%}
<div
  class="section color-{{ section_st.color_scheme }} gradient{% if section_st.show_divider and section_st.divider_top == 'line' %} border-top{% endif %}{% if section_st.show_divider and section_st.divider_bottom == 'line' %} border-bottom{% endif %}"
  style="{{ style | strip | strip_newlines }}"
  data-section-id="{{ section.id }}"
  data-testimonial-images-section
>
  <div class="{{ section_width }}">
    {%- if heading != blank or section_st.description != blank or section_st.subheading != blank -%}
      <div class="section-header text-{{ text_alignment }}">
        {%- if section_st.subheading != blank -%}
          {% if scroll_animation != 'disable' %}
            <motion-effect
              data-animate="fade-up"
              data-animate-delay="{{ animate_delay }}"
              class="block"
            >
          {% endif %}
          <div class="section-subheading h7 mb-sp-2 body_weight">
            {{ section_st.subheading }}
          </div>
          {% if scroll_animation != 'disable' %}
            </motion-effect>
          {% endif %}
        {%- endif -%}

        {%- if heading != blank -%}
          {% if scroll_animation != 'disable' or drawn_underline %}
            {% assign animate_delay = animate_delay | plus: 50 %}
            <motion-effect
              data-animate="{% if scroll_animation != 'disable' %}fade-up{% else %}highlighted-text{% endif %}"
              data-animate-delay="{{ animate_delay }}"
              class="block"
            >
          {% endif %}
          <h2 class="section-heading {{ header_size }}">
            {% if drawn_underline %}
              {%- capture squiggle_svg_1 -%}
                <svg viewBox="0 0 184 26" fill="none" class="animate"><use href="#squiggle-svg-1" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_2 -%}
                <svg viewBox="0 0 186 24" fill="none" class="animate"><use href="#squiggle-svg-2" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_3 -%}
                <svg viewBox="0 0 186 24" fill="none" class="animate"><use href="#squiggle-svg-3" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_4 -%}
                <svg viewBox="0 0 220 20" fill="none" class="animate"><use href="#squiggle-svg-4" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_5 -%}
                <svg viewBox="0 0 140 24" fill="none" role="presentation" preserveAspectRatio="none"><use href="#squiggle-svg-5" /></svg>
              {%- endcapture -%}
              {%- assign result = heading -%}
              {%- assign parts = result | split: '<em>' -%}
              {%- assign em_count = parts | size | minus: 1 -%}

              {%- for i in (1..em_count) -%}
                {%- assign idx = i | plus: 0 -%}
                {%- assign chunk = parts[idx] | default: '' -%}
                {%- assign text = chunk | split: '</em>' | first | strip_html | strip -%}
                {%- assign len_text = text | size -%}
                {%- capture open_em -%}
                {%- liquid
                  if drawn_underline_type == 'simple_underline'
                    assign svg = squiggle_svg_4 | append: '</em>'
                  elsif drawn_underline_type == 'curve_underline'
                    assign svg = squiggle_svg_5 | append: '</em>'
                  else
                    if len_text <= 4
                      assign svg = squiggle_svg_1 | append: '</em>'
                    elsif len_text <= 6
                      assign svg = squiggle_svg_2 | append: '</em>'
                    else
                      assign svg = squiggle_svg_3 | append: '</em>'
                    endif
                  endif
                -%}
                <em class="highlighted-text relative inline-flex{% if drawn_underline_type == 'simple_underline' %} simple_underline{% endif %} {{ drawn_underline_type }} not-italic" style="--animate-color:{{ drawn_underline_color }}">{{ svg }}</em>
              {%- endcapture -%}
                {%- assign open_em = open_em | remove: '</em>' -%}
                {%- assign heading = heading | replace_first: '<em>', open_em -%}
              {%- endfor -%}
            {% endif %}
            {{- heading -}}
          </h2>
          {% if scroll_animation != 'disable' or drawn_underline %}
            </motion-effect>
          {% endif %}
        {%- endif -%}

        {%- if section_st.description != blank -%}
          {% if scroll_animation != 'disable' %}
            {% assign animate_delay = animate_delay | plus: 50 %}
            <motion-effect
              data-animate="fade-up"
              data-animate-delay="{{ animate_delay }}"
              class="block"
            >
          {% endif %}
          <div class="section-description mt-sp-4 prose">
            {{ section_st.description }}
          </div>
          {% if scroll_animation != 'disable' %}
            </motion-effect>
          {% endif %}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="relative">
        <div class="flex wrap rounded overflow-hidden{% if section_st.image_desktop_position == 'right' %} row-reverse-md{% endif %}">
          <div class="w-full col-md-w-custom{% if section_st.hide_image_on_mobile %} hidden flex-md{% endif %}">
            <div class="w-full h-full relative overflow-hidden">
              <testimonial-images-media
                id="ImageWithTextCarouselMedia-{{ section.id }}"
                class="swiper w-full h-full"
                style="--item-desktop: 1;--item-tablet: 1;--item-mb: 1;--gap: 0px;--gap-desktop: 0px;"
                data-testimonial-images-media
                data-mobile="1"
                data-tablet="1"
                data-desktop="1"
                data-spacing="0"
                data-effect="fade"
                data-loop="{% if section.blocks.size > 1 %}true{% else %}false{% endif %}"
                data-speed="300"
              >
                <div class="swiper-wrapper">
                  {%- for block in section.blocks -%}
                    {%- liquid
                      assign image = block.settings.image
                      assign video = block.settings.video_local
                      assign is_video = false
                      if block.settings.media_type == 'video'
                        assign is_video = true
                      endif
                      assign image_ratio = section_st.image_ratio
                      assign ratio = '4/3'

                      if image_ratio == 'adapt'
                        if is_video
                          if video != blank
                            assign ratio = video.aspect_ratio
                          endif
                        elsif image != blank
                          assign ratio = image.aspect_ratio
                        endif
                      else
                        case image_ratio
                          when 'square'
                            assign ratio = '1/1'
                          when 'landscape'
                            assign ratio = '4/3'
                          when 'portrait'
                            assign ratio = '3/4'
                        endcase
                      endif

                      assign image_alt = image.alt
                      if image_alt == blank
                        assign image_alt = 'general.image.image_alt_default' | t
                      endif
                    -%}
                    <div class="swiper-slide w-full h-full relative overflow-hidden">
                      <div
                        class="w-full h-full"
                        style="--aspect-ratio: {{ ratio }};"
                      >
                        {%- if is_video and video != blank -%}
                          {%- liquid
                            assign source_url = ''
                            for source in video.sources
                              if source.format == 'mp4'
                                assign source_url = source.url
                                break
                              endif
                            endfor
                            assign video_alt = video.alt | default: block.settings.heading | escape
                            assign video_poster = block.settings.video_poster | default: video.preview_image
                          -%}
                          <video-local class="block w-full h-full">
                            <video
                              class="w-full h-full object-fit-cover"
                              data-src="{{ source_url }}"
                              poster="{{ video_poster | image_url: width: 1100 }}"
                              title="{{ video_alt }}"
                              autoplay
                              loop
                              muted
                              playsinline
                            ></video>
                          </video-local>
                        {%- elsif is_video == false and image != blank -%}
                          {% render 'responsive-image',
                            type: 'banner',
                            container: section_st.section_width,
                            image: image,
                            image_alt: image_alt,
                            column: 2,
                            motion: false
                          %}
                        {%- else -%}
                          {%- render 'placeholder-render',
                            type: 'lifestyle-1',
                            class: 'img-placeholder h-full w-full'
                          -%}
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              </testimonial-images-media>
            </div>
          </div>

          <div class="w-full col-md-w-custom col-md-w-custom-50">
            <div class="w-full h-full bg-secondary">
              <div
                class="flex wrap w-full h-full align-{{ section_st.desktop_vertical_alignment }} justify-content-{{ content_alignment }} text-{{ content_alignment }}{{ padding_content_class }}"
                style="--padding-inline: {{ padding_content_inline }};--padding-block: {{ padding_content_block }};--responsive-min-rate: 0.6;"
              >
                <testimonial-images-slide
                  id="ImageWithTextCarouselContent-{{ section.id }}"
                  class="swiper h-fit w-full"
                  style="--item-desktop: 1;--item-tablet: 1;--item-mb: 1;--gap: 0px;--gap-desktop: 0px;"
                  data-testimonial-images-content
                  data-section-id="{{ section.id }}"
                  data-autoplay="{{ slide_auto_change }}"
                  data-auto-play-speed="{{ change_slide_every | times: 1000 }}"
                  data-loop="{% if section.blocks.size > 1 %}true{% else %}false{% endif %}"
                  data-speed="300"
                  data-spacing="40"
                  data-mobile="1"
                  data-desktop="1"
                  data-tablet="1"
                  {% if section_st.type_pagination == 'progress_bar' %}
                    data-pagination="progressbar"
                  {% endif %}
                  data-custom-next="swiper-button-custom-next-{{ section.id }}"
                  data-custom-prev="swiper-button-custom-prev-{{ section.id }}"
                >
                  <div class="swiper-wrapper">
                    {%- for block in section.blocks -%}
                      {%- liquid
                        assign block_st = block.settings
                        assign icon = block_st.icon
                        assign button_label = block_st.first_button_label
                        assign button_link = block_st.first_button_link
                      -%}
                      <div
                        class="swiper-slide flex column align-{{ content_alignment }} gap-sp-6 gap-1025-40 px-sp-2"
                        {{ block.shopify_attributes }}
                      >
                        {%- if icon != blank -%}
                          {{
                            icon
                            | image_url: width: 160
                            | image_tag:
                              widths: '80, 160',
                              class: 'w-custom h-auto shrink-0',
                              style: '--width: 8rem;',
                              loading: 'lazy',
                              sizes: '80px'
                          }}
                        {%- endif -%}

                        {%- if block_st.heading != blank or block_st.text != blank -%}
                          <div class="w-full">
                            {%- if block_st.heading != blank -%}
                              <h3 class="h5">{{ block_st.heading }}</h3>
                            {%- endif -%}
                            {%- if block_st.text != blank -%}
                              <div class="prose rich__text-m0{% if block_st.heading != blank %} mt-sp-4{% endif %}">
                                {{ block_st.text }}
                              </div>
                            {%- endif -%}
                          </div>
                        {%- endif -%}

                        {%- if button_label != blank -%}
                          <a
                            {% if button_link == blank %}
                              role="link" aria-disabled="true"
                            {% else %}
                              href="{{ button_link }}"
                            {% endif %}
                            class="btn-{{ block_st.first_button_type }}{% if block_st.first_button_type == 'link' %} border-animation{% else %} btn inline-flex no-underline w-full content-center{% endif %} pointer"
                          >
                            {{ button_label }}
                          </a>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>

                  {% if section.blocks.size > 1 %}
                    {% if show_navigation or show_pagination or show_slide_counter %}
                      <div class="swiper-footer flex align-center justify-content-{{ content_alignment }} gap-sp-4 p-sp-2 mt-sp-4 mt-1025-sp-8">
                        {% if show_slide_counter %}
                          <span class="shrink-0 min-w-custom" style="--min-width: 1.7em;" data-slide-counter>1/{{ section.blocks.size }}</span>
                        {% endif %}

                        {% if show_pagination %}
                          <div
                            class="swiper-pagination swiper-pagination-horizontal {% if section_st.type_pagination == 'progress_bar' %}swiper-pagination-progressbar{% else %}swiper-pagination-bullets swiper-pagination-clickable{% endif %} rounded-10 overflow-x-auto hidden-scrollbar shrink-0"
                            style="--swiper-pagination-progressbar-bg-color: var(--color-border);--swiper-pagination-progressbar-size: 1px;--swiper-pagination-color: var(--btn-primary-bg-color);--margin-pagination-top: 0;--margin-pagination-top-dk: 0;"
                          >
                            {%- if section_st.type_pagination == 'progress_bar' -%}
                              <span
                                class="swiper-pagination-progressbar-fill"
                                style="transform: scaleX({{ 1.0 | divided_by: section.blocks.size }});"
                              ></span>
                            {%- else -%}
                              {%- for block in section.blocks -%}
                                <span class="swiper-pagination-bullet{% if forloop.first %} swiper-pagination-bullet-active{% endif %}"></span>
                              {%- endfor -%}
                            {%- endif -%}
                          </div>
                        {% endif %}

                        {% if show_navigation %}
                          <div class="swiper-navigation flex shrink-0">
                            <button
                              type="button"
                              class="swiper-button-custom-prev-{{ section.id }} swiper-button-custom-prev btn-reset flex content-center pointer heading-color rtl-mirror w-custom h-custom"
                              style="--width: 2.4rem; --height: 2.4rem;"
                              aria-label="{{ 'accessibility.previous_slide' | t }}"
                            >
                              <svg width="7" height="13" viewBox="0 0 6 11" fill="none" aria-hidden="true">
                                <use href="#icon-back" />
                              </svg>
                            </button>
                            <button
                              type="button"
                              class="swiper-button-custom-next-{{ section.id }} swiper-button-custom-next btn-reset flex content-center pointer heading-color rtl-mirror w-custom h-custom"
                              style="--width: 2.4rem; --height: 2.4rem;"
                              aria-label="{{ 'accessibility.next_slide' | t }}"
                            >
                              <svg width="7" height="13" viewBox="0 0 6 11" fill="none" aria-hidden="true">
                                <use href="#icon-next" />
                              </svg>
                            </button>
                          </div>
                        {% endif %}
                      </div>
                    {% endif %}
                  {% endif %}
                </testimonial-images-slide>
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{%- render 'section-divider', position: 'bottom', style: section_st.divider_bottom, color_scheme: section_st.color_scheme, enabled: section_st.show_divider -%}

{% schema %}
{
  "name": "t:sections.image-with-text-carousel.name",
  "tag": "section",
  "class": "section section-image-with-text-carousel",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.image-with-text-carousel.how_to_use"
    },
    {
      "type": "header",
      "content": "t:sections.all.general"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "fix_width",
          "label": "t:sections.all.layout.fix_width"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.layout.stretch_width"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.layout.full_width"
        }
      ],
      "default": "fix_width",
      "label": "t:sections.all.layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.info",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_header.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.content_setting.subheading.label",
      "default": "Subheading"
    },
    {
      "type": "richtext",
      "id": "title",
      "default": "<p>Heading</p>",
      "label": "t:sections.all.content_setting.heading.label"
    },
    {
      "type": "checkbox",
      "id": "drawn_underline",
      "default": true,
      "label": "t:sections.all.content_setting.drawn_underline.label",
      "info": "t:sections.all.content_setting.heading.info"
    },
    {
      "type": "select",
      "id": "drawn_underline_type",
      "label": "t:sections.all.content_setting.drawn_underline.type",
      "default": "squiggle_underline",
      "visible_if": "{{ section.settings.drawn_underline != false }}",
      "options": [
        {
          "value": "simple_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.simple_underline"
        },
        {
          "value": "curve_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.curve_underline"
        },
        {
          "value": "squiggle_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.squiggle_underline"
        }
      ]
    },
    {
      "type": "color",
      "id": "drawn_underline_color",
      "label": "t:sections.all.content_setting.drawn_underline.color",
      "default": "#FFB005",
      "alpha": true,
      "visible_if": "{{ section.settings.drawn_underline != false }}"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.all.content_setting.description.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "large",
          "label": "t:sections.all.content_header.heading_size.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.all.content_header.heading_size.options__2.label"
        },
        {
          "value": "small",
          "label": "t:sections.all.content_header.heading_size.options__3.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.all.content_header.heading_size.label"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.text_alignment.alignment"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_setting.label"
    },
    {
      "type": "select",
      "id": "image_desktop_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.image.desktop_position.left"
        },
        {
          "value": "right",
          "label": "t:sections.all.image.desktop_position.right"
        }
      ],
      "default": "left",
      "label": "t:sections.all.image.desktop_position.label",
      "info": "t:sections.all.image.desktop_position.info"
    },
    {
      "type": "select",
      "id": "desktop_vertical_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.top"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.middle"
        },
        {
          "value": "end",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.bottom"
        }
      ],
      "default": "center",
      "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.label"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.text_alignment.label"
    },
    {
      "type": "range",
      "id": "padding_content_inline",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_inline.label",
      "info": "t:sections.all.padding.padding_inline.info",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_content_block",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_block.label",
      "info": "t:sections.all.padding.padding_block.info",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "hide_image_on_mobile",
      "label": "t:sections.testimonial-images.settings.hide_image_on_mobile.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.carousel.header"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "default": true,
      "label": "t:sections.all.carousel.show_navigation.label"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
