{%- liquid
  assign theme_st = settings
  assign section_st = section.settings
  assign scroll_animation = theme_st.scroll_animation
  assign heading = section_st.heading
  assign heading_size = section_st.heading_size
  assign drawn_underline = section_st.drawn_underline
  assign drawn_underline_type = section_st.drawn_underline_type
  assign drawn_underline_color = section_st.drawn_underline_color
  assign alignment = section_st.text_alignment
  assign header_size = ''
  if heading_size == 'small'
    assign header_size = 'h3'
  elsif heading_size == 'large'
    assign header_size = 'h1'
  endif
  if drawn_underline
    assign scroll_animation = 'disable'
  endif
  if section_st.section_width == 'fix_width'
    assign section_width = 'container'
  elsif section_st.section_width == 'full_width'
    assign section_width = 'full-width'
  else
    assign section_width = 'fluid_container'
  endif

  assign columns = section.blocks | where: 'type', 'column'
  assign rows = section.blocks | where: 'type', 'row'
  assign heading_id = 'ComparisonTable-Heading-' | append: section.id
  assign yes_label = 'sections.comparison_table.yes' | t
  assign no_label = 'sections.comparison_table.no' | t
  assign empty_label = 'sections.comparison_table.not_applicable' | t

  assign highlight_scheme = section_st.color_column_highlight
  assign highlight_background = highlight_scheme.settings.background
  assign highlight_border = 'var(--color-border)'
  if highlight_background != blank
    if highlight_background.alpha > 0
      assign highlight_border_offset = 23
      assign highlight_border_red = highlight_background.red | minus: highlight_border_offset | round | at_least: 0
      assign highlight_border_green = highlight_background.green | minus: highlight_border_offset | round | at_least: 0
      assign highlight_border_blue = highlight_background.blue | minus: highlight_border_offset | round | at_least: 0
      assign highlight_border = highlight_background | color_modify: 'red', highlight_border_red | color_modify: 'green', highlight_border_green | color_modify: 'blue', highlight_border_blue
    endif
  endif

  assign highlighted = ''
  for column in columns
    if column.settings.highlight
      assign highlighted = highlighted | append: ',' | append: forloop.index | append: ','
    endif
  endfor

  assign show_labels = false
  if section_st.show_labels
    if section_st.first_label != blank or section_st.second_label != blank
      assign show_labels = true
    endif
  endif
  assign show_notes = false
  if columns.size > 0 and rows.size > 0
    if show_labels or section_st.notes_description != blank
      assign show_notes = true
    endif
  endif
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }}; --max-width: {{ section_st.max_width }}%; --columns: {{ columns.size }};
  {%- if highlight_background != blank -%}
    --highlight-bg: {{ highlight_background }}; --highlight-border: {{ highlight_border }};
  {%- endif -%}
  {%- if highlight_scheme != blank -%}
    --highlight-text: {{ highlight_scheme.settings.text_color }}; --highlight-heading: {{ highlight_scheme.settings.heading_color }}; --highlight-outer-border: {{ highlight_scheme.settings.border_color }};
    --highlight-primary-bg: {{ highlight_scheme.settings.btn_primary_background }}; --highlight-primary-color: {{ highlight_scheme.settings.btn_primary_color }};
  {%- endif -%}
{%- endcapture -%}

{%- capture icon_yes -%}
  <svg class="comparison-table__icon inline-block" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
    <circle cx="14" cy="14" r="14" fill="currentColor" />
    <svg x="9" y="10" width="10" height="8" viewBox="0 0 15 12" class="color-primary">
      <use href="#icon-tick"></use>
    </svg>
  </svg>
{%- endcapture -%}
{%- capture icon_no -%}
  <svg class="comparison-table__icon inline-block" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
    <circle cx="14" cy="14" r="13.5" stroke="currentColor" />
    <svg x="10" y="10" width="8" height="8" viewBox="0 0 12 12">
      <use href="#icon-close"></use>
    </svg>
  </svg>
{%- endcapture -%}

{%- render 'section-divider', position: 'top', style: section_st.divider_top, color_scheme: section_st.color_scheme, enabled: section_st.show_divider -%}
<div
  class="section section__comparison-table color-{{ section_st.color_scheme }} gradient{% if section_st.show_divider and section_st.divider_top == 'line' %} border-top{% endif %}{% if section_st.show_divider and section_st.divider_bottom == 'line' %} border-bottom{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <div class="max-w-custom mx-auto">
      {%- if section_st.subheading != blank or heading != blank or section_st.description != blank -%}
        <div class="section-header text-{{ alignment }}">
          {% assign animate_delay = 50 %}
          {%- if section_st.subheading != blank -%}
            {% if scroll_animation != 'disable' %}
              <motion-effect
                data-animate="fade-up"
                data-animate-delay="{{ animate_delay }}"
                class="block"
              >
            {% endif %}
            <div class="section-subheading h7 mb-sp-1 mb-1025-sp-2 subheading_weight">
              {{ section_st.subheading }}
            </div>
            {% if scroll_animation != 'disable' %}
              </motion-effect>
            {% endif %}
          {%- endif -%}
          {%- if heading != blank -%}
            {% assign animate_delay = animate_delay | plus: 50 %}
            {% if scroll_animation != 'disable' or drawn_underline %}
              <motion-effect
                data-animate="{% if scroll_animation != 'disable' %}fade-up{% else %}highlighted-text{% endif %}"
                data-animate-delay="{{ animate_delay }}"
                class="block"
              >
            {% endif %}
            <h2 id="{{ heading_id }}" class="section-heading {{ header_size }}">
              {% if drawn_underline %}
                {%- capture squiggle_svg_1 -%}
                  <svg viewBox="0 0 184 26" fill="none"><use href="#squiggle-svg-1" /></svg>
                {%- endcapture -%}
                {%- capture squiggle_svg_2 -%}
                  <svg viewBox="0 0 186 24" fill="none"><use href="#squiggle-svg-2" /></svg>
                {%- endcapture -%}
                {%- capture squiggle_svg_3 -%}
                  <svg viewBox="0 0 186 24" fill="none"><use href="#squiggle-svg-3" /></svg>
                {%- endcapture -%}
                {%- capture squiggle_svg_4 -%}
                  <svg viewBox="0 0 220 20" fill="none"><use href="#squiggle-svg-4" /></svg>
                {%- endcapture -%}
                {%- capture squiggle_svg_5 -%}
                  <svg viewBox="0 0 140 24" fill="none" role="presentation" preserveAspectRatio="none"><use href="#squiggle-svg-5" /></svg>
                {%- endcapture -%}
                {%- assign heading_parts = heading | split: '<em>' -%}
                {%- assign emphasized_count = heading_parts | size | minus: 1 -%}
                {%- for i in (1..emphasized_count) -%}
                  {%- assign emphasized_index = i | plus: 0 -%}
                  {%- assign heading_chunk = heading_parts[emphasized_index] | default: '' -%}
                  {%- assign emphasized_text = heading_chunk | split: '</em>' | first | strip_html | strip -%}
                  {%- assign emphasized_length = emphasized_text | size -%}
                  {%- capture opening_em -%}
                    {%- liquid
                      if drawn_underline_type == 'simple_underline'
                        assign underline_svg = squiggle_svg_4 | append: '</em>'
                      elsif drawn_underline_type == 'curve_underline'
                        assign underline_svg = squiggle_svg_5 | append: '</em>'
                      else
                        if emphasized_length <= 4
                          assign underline_svg = squiggle_svg_1 | append: '</em>'
                        elsif emphasized_length <= 6
                          assign underline_svg = squiggle_svg_2 | append: '</em>'
                        else
                          assign underline_svg = squiggle_svg_3 | append: '</em>'
                        endif
                      endif
                    -%}
                    <em class="highlighted-text relative inline-flex{% if drawn_underline_type == 'simple_underline' %} simple_underline{% endif %} {{ drawn_underline_type }} not-italic" style="--animate-color: {{ drawn_underline_color }}">{{ underline_svg }}</em>
                  {%- endcapture -%}
                  {%- assign opening_em = opening_em | remove: '</em>' -%}
                  {%- assign heading = heading | replace_first: '<em>', opening_em -%}
                {%- endfor -%}
              {% endif %}
              {{- heading -}}
            </h2>
            {% if scroll_animation != 'disable' or drawn_underline %}
              </motion-effect>
            {% endif %}
          {%- endif -%}
          {%- if section_st.description != blank -%}
            {% assign animate_delay = animate_delay | plus: 50 %}
            {% if scroll_animation != 'disable' %}
              <motion-effect
                data-animate="fade-up"
                data-animate-delay="{{ animate_delay }}"
                class="block"
              >
            {% endif %}
            <div class="section-description mt-sp-4 prose">
              {{ section_st.description }}
            </div>
            {% if scroll_animation != 'disable' %}
              </motion-effect>
            {% endif %}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if columns.size > 0 -%}
        {% if scroll_animation != 'disable' %}
          <motion-effect data-animate="fade-up" class="block">
        {% endif %}
        <div
          class="comparison-table__scroll relative overflow-auto focus-inset"
          role="region"
          tabindex="0"
          {% if heading != blank %}
            aria-labelledby="{{ heading_id }}"
          {% else %}
            aria-label="{{ 'sections.comparison_table.table_label' | t }}"
          {% endif %}
        >
          <table class="comparison-table__table w-full text-center border-0 fs-small{% if section_st.show_column_images %} comparison-table__table--images{% endif %}">
            <thead>
              <tr>
                {% if section_st.comparison_heading != blank %}
                  <th scope="col" class="comparison-table__criteria text-start border-0 h-auto">
                    <span class="comparison-table__heading block h7 heading-color">
                      {{- section_st.comparison_heading | escape -}}
                    </span>
                  </th>
                {% else %}
                  <td class="comparison-table__criteria border-0 h-auto"></td>
                {% endif %}
                {%- for column in columns -%}
                  {%- liquid
                    assign column_index = ',' | append: forloop.index | append: ','
                    assign column_tag = 'th'
                    if column.settings.heading == blank
                      assign column_tag = 'td'
                    endif
                  -%}
                  <{{ column_tag }}
                    {% if column_tag == 'th' %}
                      scope="col"
                    {% endif %}
                    class="comparison-table__column relative border-0 h-auto{% if highlighted contains column_index %} is-highlight{% endif %}"
                    {{ column.shopify_attributes }}
                  >
                    <div class="flex column align-center gap-sp-1 gap-1025-sp-2">
                      {%- if section_st.show_column_images -%}
                        <div class="comparison-table__media absolute top-custom left-0 right-0 mx-auto rounded-50 overflow-hidden max-w-100">
                          {%- if column.settings.image != blank -%}
                            {%- assign image_alt = column.settings.image.alt | default: '' | escape -%}
                            {% render 'responsive-image',
                              image: column.settings.image,
                              image_alt: image_alt,
                              class: 'w-full h-full object-fit-cover',
                              custom_widths: '180, 120, 90, 60',
                              sizes: '(min-width: 768px) 90px, 60px'
                            %}
                          {%- else -%}
                            {% render 'placeholder-render',
                              type: 'product',
                              index: forloop.index,
                              class: 'img-placeholder w-full h-full',
                              motion: false
                            %}
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                      {%- if column.settings.heading != blank -%}
                        <span class="comparison-table__heading h7 heading-color word-break">
                          {{- column.settings.heading | escape -}}
                        </span>
                      {%- endif -%}
                    </div>
                  </{{ column_tag }}>
                {%- endfor -%}
              </tr>
            </thead>
            {%- if rows.size > 0 -%}
              <tbody>
                {%- for row in rows -%}
                  <tr {{ row.shopify_attributes }}>
                    {% if row.settings.heading != blank %}
                      <th scope="row" class="comparison-table__criteria text-start word-break border-0 p-sp-2">
                        {{ row.settings.heading | escape }}
                      </th>
                    {% else %}
                      <td class="comparison-table__criteria border-0 p-sp-2"></td>
                    {% endif %}
                    {%- for column in columns -%}
                      {%- liquid
                        assign text_key = 'text_' | append: forloop.index
                        assign icon_key = 'icon_' | append: forloop.index
                        assign image_key = 'image_' | append: forloop.index
                        assign cell_text = row.settings[text_key]
                        assign cell_icon = row.settings[icon_key]
                        assign cell_image = row.settings[image_key]
                        assign column_index = ',' | append: forloop.index | append: ','
                      -%}
                      <td class="word-break border-0 p-sp-2{% if highlighted contains column_index %} is-highlight{% endif %}">
                        {%- case cell_icon -%}
                          {%- when 'image' -%}
                            {%- if cell_image != blank -%}
                              {%- liquid
                                assign image_alt = 'general.image.image_alt_default' | t
                                assign image_alt = cell_image.alt | default: image_alt | escape
                              -%}
                              <div class="comparison-table__cell-image inline-flex">
                                {% render 'responsive-image',
                                  image: cell_image,
                                  image_alt: image_alt,
                                  class: 'comparison-table__cell-img w-full h-full',
                                  custom_widths: '80, 40',
                                  sizes: '40px'
                                %}
                              </div>
                            {%- else -%}
                              <span class="visually-hidden">{{ empty_label }}</span>
                            {%- endif -%}
                          {%- when 'yes' -%}
                            {{ icon_yes }}
                            <span class="visually-hidden">
                              {{- section_st.first_label | default: yes_label | escape -}}
                            </span>
                          {%- when 'no' -%}
                            {{ icon_no }}
                            <span class="visually-hidden">
                              {{- section_st.second_label | default: no_label | escape -}}
                            </span>
                          {%- else -%}
                            {%- if cell_text != blank -%}
                              {{ cell_text | escape }}
                            {%- else -%}
                              <span class="visually-hidden">{{ empty_label }}</span>
                            {%- endif -%}
                        {%- endcase -%}
                      </td>
                    {%- endfor -%}
                  </tr>
                {%- endfor -%}
              </tbody>
            {%- endif -%}
          </table>
        </div>
        {% if scroll_animation != 'disable' %}
          </motion-effect>
        {% endif %}
      {%- endif -%}

      {%- if show_notes -%}
        {% if scroll_animation != 'disable' %}
          <motion-effect data-animate="fade-up" data-animate-delay="50" class="block">
        {% endif %}
        <div
          class="mt-sp-6 mt-1025-sp-10 text-color text-{{ alignment }}"
          style="--opacity: 0.82;"
        >
          {%- if show_labels -%}
            <ul
              class="comparison-table__notes list-unstyled flex wrap gap-sp-6 gap-1025-40 justify-content-{{ alignment }}"
              role="list"
            >
              {%- if section_st.first_label != blank -%}
                <li class="flex align-center gap-sp-3">
                  {{ icon_yes -}}
                  <span class="opacity">{{ section_st.first_label | escape }}</span>
                </li>
              {%- endif -%}
              {%- if section_st.second_label != blank -%}
                <li class="flex align-center gap-sp-3">
                  {{ icon_no -}}
                  <span class="opacity">{{ section_st.second_label | escape }}</span>
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}
          {%- if section_st.notes_description != blank -%}
            <div class="prose opacity{% if show_labels %} mt-sp-2 mt-1025-sp-3{% endif %}">
              {{ section_st.notes_description }}
            </div>
          {%- endif -%}
        </div>
        {% if scroll_animation != 'disable' %}
          </motion-effect>
        {% endif %}
      {%- endif -%}

      {%- if section_st.button_label != blank -%}
        {% if scroll_animation != 'disable' %}
          <motion-effect data-animate="fade-up" data-animate-delay="100" class="block">
        {% endif %}
        <div class="flex justify-content-{{ alignment }} mt-sp-6 mt-1025-sp-10">
          <a
            {% if section_st.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section_st.button_link }}"
            {% endif %}
            class="pointer text-center btn-{{ section_st.button_type }}{% if section_st.button_type == 'link' %} align-self-center border-animation{% else %} btn w-full min-w-md-custom w-md-auto max-w-100{% endif %}"
            {% if section_st.button_type != 'link' %}
              style="--width: 25rem;"
            {% endif %}
          >
            {{ section_st.button_label | escape }}
          </a>
        </div>
        {% if scroll_animation != 'disable' %}
          </motion-effect>
        {% endif %}
      {%- endif -%}
    </div>
  </div>
</div>
{%- render 'section-divider', position: 'bottom', style: section_st.divider_bottom, color_scheme: section_st.color_scheme, enabled: section_st.show_divider -%}

{% stylesheet %}
  .comparison-table__table {
    --cell-height: 6.1rem;
    --end-padding: var(--sp-4);
    --head-padding-top: var(--sp-4);
    --head-padding-bottom: var(--sp-2);
    --media-size: 6rem;
    --media-gap: var(--sp);
    --icon-size: 2.8rem;
    min-width: calc((var(--columns) + 1) * 13rem);
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }

  .comparison-table__table :is(th, td) {
    height: var(--cell-height);
    font-weight: inherit;
    vertical-align: middle;
  }

  .comparison-table__table .comparison-table__criteria {
    position: sticky;
    inset-inline-start: 0;
    z-index: 1;
    width: 13rem;
    padding-inline-start: 0;
    background: var(--color-background);
  }

  .comparison-table__table thead :is(th, td) {
    padding-block: calc(var(--head-padding-top) - var(--head-top-border, 0px)) var(--head-padding-bottom);
    border-block-end: 1px solid var(--comparison-row-border, var(--color-border));
    vertical-align: top;
  }

  .comparison-table__table--images .comparison-table__column {
    padding-block-start: calc(var(--head-padding-top) + var(--media-size) - var(--head-top-border, 0px));
  }

  .comparison-table__table--images
    thead
    :is(.comparison-table__column, .comparison-table__criteria):has(.comparison-table__heading) {
    padding-block-start: calc(
      var(--head-padding-top) + var(--media-size) + var(--media-gap) - var(--head-top-border, 0px)
    );
  }

  .comparison-table__table tbody tr:not(:last-child) > * {
    border-block-end: 1px solid var(--comparison-row-border, var(--color-border));
  }

  .comparison-table__table tbody tr:last-child > * {
    height: calc(var(--cell-height) - 1px + var(--end-padding));
    padding-block-end: var(--end-padding);
  }

  .comparison-table__table .is-highlight {
    --comparison-row-border: var(--highlight-border, var(--color-border));
    background: var(--highlight-bg, transparent);
    color: var(--highlight-text, var(--color-text));
    border-inline: 1px solid var(--highlight-outer-border, var(--color-border));
  }

  .comparison-table__table .is-highlight .comparison-table__heading {
    color: var(--highlight-heading, var(--color-heading));
  }

  .comparison-table__table thead .is-highlight {
    --head-top-border: 1px;
    border-block-start: 1px solid var(--highlight-outer-border, var(--color-border));
    border-start-start-radius: var(--img-rounded);
    border-start-end-radius: var(--img-rounded);
  }

  .comparison-table__table :is(thead:last-child, tbody tr:last-child) .is-highlight {
    border-block-end: 1px solid var(--highlight-outer-border, var(--color-border));
    border-end-start-radius: var(--img-rounded);
    border-end-end-radius: var(--img-rounded);
  }

  .comparison-table__heading {
    font-size: var(--body-font-size);
  }

  .comparison-table__media {
    --top-custom: calc(var(--head-padding-top) - var(--head-top-border, 0px));
    width: var(--media-size);
    aspect-ratio: 1;
  }

  .comparison-table__cell-image {
    width: 4rem;
    height: 4rem;
    vertical-align: middle;
  }

  .comparison-table__cell-img {
    object-fit: contain;
  }

  .comparison-table__icon {
    width: var(--icon-size, 2.8rem);
    height: var(--icon-size, 2.8rem);
    color: var(--btn-primary-bg-color);
  }

  .comparison-table__table .is-highlight .comparison-table__icon {
    color: var(--highlight-primary-bg, var(--btn-primary-bg-color));
  }

  .comparison-table__table .is-highlight .comparison-table__icon .color-primary {
    color: var(--highlight-primary-color, var(--btn-primary-color));
  }

  .comparison-table__notes {
    --icon-size: 2.4rem;
  }

  @media (max-width: 767.98px) {
    .section__comparison-table :is(.container, .fluid_container) .comparison-table__scroll {
      margin-inline-end: calc(var(--bs-gutter-x, 1.5rem) * -1);
    }
  }

  @media (min-width: 768px) {
    .comparison-table__table {
      --cell-height: 6.6rem;
      --end-padding: var(--sp-6);
      --head-padding-top: var(--sp-6);
      --head-padding-bottom: var(--sp-6);
      --media-size: 9rem;
      min-width: 0;
      font-size: inherit;
    }

    .comparison-table__heading {
      font-size: var(--h7);
    }

    .comparison-table__table .comparison-table__criteria {
      position: static;
      width: 32%;
      background: none;
    }
  }

  @media (min-width: 1025px) {
    .comparison-table__table {
      --media-gap: var(--sp-2);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.comparison-table.name",
  "tag": "section",
  "class": "section-comparison-table",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 19,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.general"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "fix_width",
          "label": "t:sections.all.layout.fix_width"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.layout.stretch_width"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.layout.full_width"
        }
      ],
      "default": "fix_width",
      "label": "t:sections.all.layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.info",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_header.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.content_setting.subheading.label"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:sections.all.content_setting.heading.label"
    },
    {
      "type": "checkbox",
      "id": "drawn_underline",
      "default": true,
      "label": "t:sections.all.content_setting.drawn_underline.label",
      "info": "t:sections.all.content_setting.heading.info"
    },
    {
      "type": "select",
      "id": "drawn_underline_type",
      "label": "t:sections.all.content_setting.drawn_underline.type",
      "default": "squiggle_underline",
      "visible_if": "{{ section.settings.drawn_underline != false }}",
      "options": [
        {
          "value": "simple_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.simple_underline"
        },
        {
          "value": "curve_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.curve_underline"
        },
        {
          "value": "squiggle_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.squiggle_underline"
        }
      ]
    },
    {
      "type": "color",
