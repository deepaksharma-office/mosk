{%- liquid
  assign section_st = section.settings
  if section_st.section_width == 'fix_width'
    assign section_width = 'container'
  elsif section_st.section_width == 'full_width'
    assign section_width = 'full-width'
  else
    assign section_width = 'full-width-gap'
  endif
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{%- unless section_st.custom_liquid == blank -%}
  {%- render 'section-divider', position: 'top', style: section_st.divider_top, color_scheme: section_st.color_scheme, enabled: section_st.show_divider -%}
  <div
    class="section color-{{ section_st.color_scheme }} section gradient section__custom-liquid{% if section_st.show_divider and section_st.divider_top == 'line' %} border-top{% endif %}{% if section_st.show_divider and section_st.divider_bottom == 'line' %} border-bottom{% endif %}"
    style="{{ style | strip | strip_newlines }}"
  >
    <div class="{{ section_width }}">
      <div class="sec__inner">
        {{ section_st.custom_liquid }}
      </div>
    </div>
  </div>
  {%- render 'section-divider', position: 'bottom', style: section_st.divider_bottom, color_scheme: section_st.color_scheme, enabled: section_st.show_divider -%}
{%- endunless -%}
{% schema %}
{
  "name": "t:sections.custom_liquid.name",
  "tag": "section",
  "disabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.custom_liquid.how_to_use"
    },
    {
      "type": "header",
      "content": "t:sections.all.general"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "fix_width",
          "label": "t:sections.all.layout.fix_width"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.layout.stretch_width"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.layout.full_width"
        }
      ],
      "default": "fix_width",
      "label": "t:sections.all.layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.info",
      "default": "default-color-scheme"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom_liquid.name",
      "info": "t:sections.custom_liquid.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.section_divider_heading"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.all.divider.show_divider",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_top",
      "label": "t:sections.all.divider.top",
      "info": "t:sections.all.divider.top_info",
      "options": [
        { "value": "none", "label": "t:sections.all.divider.none" },
        { "value": "line", "label": "t:sections.all.divider.line" },
        { "value": "wave", "label": "t:sections.all.divider.wave" },
        { "value": "curve-out", "label": "t:sections.all.divider.curve_out" },
        { "value": "curve-in", "label": "t:sections.all.divider.curve_in" }
      ],
      "default": "line",
      "visible_if": "{{ section.settings.show_divider }}"
    },
    {
      "type": "select",
      "id": "divider_bottom",
      "label": "t:sections.all.divider.bottom",
      "info": "t:sections.all.divider.bottom_info",
      "options": [
        { "value": "none", "label": "t:sections.all.divider.none" },
        { "value": "line", "label": "t:sections.all.divider.line" },
        { "value": "wave", "label": "t:sections.all.divider.wave" },
        { "value": "curve-out", "label": "t:sections.all.divider.curve_out" },
        { "value": "curve-in", "label": "t:sections.all.divider.curve_in" }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.show_divider }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_liquid.name",
      "category": "t:sections.group.blocks.layout"
    }
  ]
}
{% endschema %}
