{%- liquid
  assign section_st = section.settings

  if section_st.section_width == 'fix_width'
    assign section_width = 'container'
  elsif section_st.section_width == 'full_width'
    assign section_width = 'full-width'
  else
    assign section_width = 'fluid_container'
  endif

  assign column_gap_slide = 32
  assign column_gap_mb = 16
  if section_st.column_gap == 'no_gap'
    assign column_gap_slide = 0
    assign column_gap_mb = 0
  elsif section_st.column_gap == 'x_large'
    assign column_gap_slide = 100
    assign column_gap_mb = 24
  elsif section_st.column_gap == 'large'
    assign column_gap_slide = 32
    assign column_gap_mb = 16
  elsif section_st.column_gap == 'medium'
    assign column_gap_slide = 24
    assign column_gap_mb = 12
  elsif section_st.column_gap == 'small'
    assign column_gap_slide = 16
    assign column_gap_mb = 8
  endif

  assign image_ratio = section_st.image_ratio
  assign ratio = '3/4'
  if image_ratio != 'adapt'
    case image_ratio
      when 'square'
        assign ratio = '1/1'
      when 'landscape'
        assign ratio = '4/3'
      when 'portrait'
        assign ratio = '3/4'
    endcase
  elsif section_st.image != blank and section_st.change_image_on_scroll != true
    assign ratio = section_st.image.aspect_ratio
  endif

  assign alt = 'accessibility.promotion_banner' | t
  if section_st.image.alt
    assign alt = section_st.image.alt | escape
  endif

  assign header_size = ''
  if section_st.heading_size == 'small'
    assign header_size = 'h3'
  elsif section_st.heading_size == 'large'
    assign header_size = 'h1'
  endif

  assign theme_st = settings
  assign scroll_animation = theme_st.scroll_animation
  assign heading = section_st.heading
  assign drawn_underline = section_st.drawn_underline
  assign drawn_underline_type = section_st.drawn_underline_type
  assign drawn_underline_color = section_st.drawn_underline_color
  if drawn_underline
    assign scroll_animation = 'disable'
  endif

  assign scroll_change_image = section_st.change_image_on_scroll
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }};
  --section-pb: {{ section_st.padding_bottom }};
  --col-width: {{ section_st.desktop_image_width }}%;
{%- endcapture -%}

{%- capture row_style -%}
  --gap: {{ column_gap_mb }}px;
  --gap-desktop: {{ column_gap_slide }}px;
{%- endcapture -%}

{%- capture content_style -%}
  --col-number: {{ section_st.items_per_row }};
  --item-mb: {{ section_st.items_per_row }};
  --gap: {{ column_gap_mb }}px;
{%- endcapture -%}

{% style %}
  #shopify-section-{{ section.id }}
    .sticky-image-with-text__group-text
    :is(
      .list-tag,
      .justify_block, .image-media
    ) {
    display: flex;
    justify-content: var(--text-group-justify-mobile);
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }}
      .sticky-image-with-text__group-text
      :is(
        .list-tag,
        .justify_block, .image-media
      ) {
      justify-content: var(--text-group-justify-desktop);
    }
  }

  @media screen and (min-width: 1025px) {
    #shopify-section-{{ section.id }} .sticky-image-with-text__content > * > .group__text {
      min-height: var(--sticky-media-height, auto);
      align-items: center;
    }
  }

  @media screen and (max-width: 1024.98px) {
    #shopify-section-{{ section.id }} .sticky-image-with-text__content .group__text .block-icon  {
      height: fit-content;
    }
  }
{% endstyle %}

{%- render 'section-divider',
  position: 'top',
  style: section_st.divider_top,
  color_scheme: section_st.color_scheme,
  enabled: section_st.show_divider
-%}
<sticky-image-with-text
  class="section block color-{{ section_st.color_scheme }} gradient section__sticky-image-with-text overflow-hidden-mb{% if section_st.show_divider and section_st.divider_top == 'line' %} border-top{% endif %}{% if section_st.show_divider and section_st.divider_bottom == 'line' %} border-bottom{% endif %}"
  style="{{ style | strip | strip_newlines }}"
  {% if scroll_change_image %}
    data-change-image-on-scroll
    {% if image_ratio == 'adapt' %}
      data-ratio-adapt
    {% endif %}
  {% endif %}
>
  <div class="{{ section_width }}">
    {%- if section_st.heading != blank or section_st.subheading != blank or section_st.description != blank -%}
      <div class="sticky-image-with-text__header section-header text-{{ section_st.content_alignment }}">
        {% assign animate_delay = 25 %}
        {%- if section_st.subheading != blank -%}
          {%- if scroll_animation != 'disable' -%}
            <motion-effect data-animate="fade-up" data-animate-delay="{{ animate_delay }}" class="block">
          {%- endif -%}
          <div class="section-subheading h7 mb-sp-1 mb-1025-sp-2 subheading_weight">{{ section_st.subheading }}</div>
          {%- if scroll_animation != 'disable' -%}
            </motion-effect>
          {%- endif -%}
        {%- endif -%}
        {%- if section_st.heading != blank -%}
          {% assign animate_delay = animate_delay | plus: 50 %}
          {% if scroll_animation != 'disable' or drawn_underline %}
            <motion-effect
              data-animate="{% if scroll_animation != 'disable' %}fade-up{% else %}highlighted-text{% endif %}"
              data-animate-delay="{{ animate_delay }}"
              class="block"
            >
          {%- endif -%}
          <h2 class="block section-heading {{ header_size }}">
            {% if drawn_underline %}
              {%- capture squiggle_svg_1 -%}
                <svg viewBox="0 0 184 26" fill="none"><use href="#squiggle-svg-1" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_2 -%}
                <svg viewBox="0 0 186 24" fill="none"><use href="#squiggle-svg-2" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_3 -%}
                <svg viewBox="0 0 186 24" fill="none"><use href="#squiggle-svg-3" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_4 -%}
                <svg viewBox="0 0 220 20" fill="none"><use href="#squiggle-svg-4" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_5 -%}
                <svg viewBox="0 0 140 24" fill="none" role="presentation" preserveAspectRatio="none"><use href="#squiggle-svg-5" /></svg>
              {%- endcapture -%}
              {%- assign result = heading -%}
              {%- assign parts = result | split: '<em>' -%}
              {%- assign em_count = parts | size | minus: 1 -%}
              {%- for i in (1..em_count) -%}
                {%- assign idx = i | plus: 0 -%}
                {%- assign chunk = parts[idx] | default: '' -%}
                {%- assign text = chunk | split: '</em>' | first | strip_html | strip -%}
                {%- assign len_text = text | size -%}
                {%- capture open_em -%}
                {%- liquid
                  if drawn_underline_type == 'simple_underline'
                    assign svg = squiggle_svg_4 | append: '</em>'
                  elsif drawn_underline_type == 'curve_underline'
                    assign svg = squiggle_svg_5 | append: '</em>'
                  else
                    if len_text <= 4
                      assign svg = squiggle_svg_1 | append: '</em>'
                    elsif len_text <= 6
                      assign svg = squiggle_svg_2 | append: '</em>'
                    else
                      assign svg = squiggle_svg_3 | append: '</em>'
                    endif
                  endif
                -%}
                <em class="highlighted-text relative inline-flex{% if drawn_underline_type == 'simple_underline' %} simple_underline{% endif %} {{ drawn_underline_type }} not-italic" style="--animate-color:{{ drawn_underline_color }}">{{ svg }}</em>
                {%- endcapture -%}
                {%- assign open_em = open_em | remove: '</em>' -%}
                {%- assign heading = heading | replace_first: '<em>', open_em -%}
              {%- endfor -%}
            {% endif %}
            {{- heading -}}
          </h2>
          {% if scroll_animation != 'disable' or drawn_underline %}
            </motion-effect>
          {%- endif -%}
        {%- endif -%}
        {%- if section_st.description != blank -%}
          {% assign animate_delay = animate_delay | plus: 50 %}
          {%- if scroll_animation != 'disable' -%}
            <motion-effect data-animate="fade-up" data-animate-delay="{{ animate_delay }}" class="block">
          {%- endif -%}
          <div class="section-description mt-sp-4 prose">{{ section_st.description }}</div>
          {%- if scroll_animation != 'disable' -%}
            </motion-effect>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
    <div
      class="sticky-image-with-text__row flex wrap gap{% if section_st.image_desktop_position == 'right' %} row-reverse-1025{% endif %}"
      style="{{ row_style | strip | strip_newlines }}"
    >
      <div
        class="sticky-image-with-text__media-col h-fit w-full col-1025-w-custom sticky-1025 top-custom{% if section_st.hide_image_mobile %} hidden block-1025{% endif %}"
        style="--top-custom: 40px;"
      >
        <div class="sticky-image-with-text__sticky">
          <div
            class="sticky-image-with-text__media banner__media rounded"
            style="--aspect-ratio: {{ ratio }};"
          >
            {%- capture default_media -%}
              {%- if section_st.image != blank and scroll_change_image != true -%}
                {% render 'responsive-image',
                  type: 'banner',
                  container: section_width,
                  image: section_st.image,
                  image_alt: alt,
                  motion: true,
                  animate: 'zoom-out'
                %}
              {%- else -%}
                {% render 'placeholder-render', type: 'collection-6', class: 'img-placeholder h-full w-full' %}
              {%- endif -%}
            {%- endcapture -%}
            {%- if scroll_change_image -%}
              <div
                class="sticky-image-with-text__slide absolute inset-0 transition opacity-1"
                style="--transition: 0.5s var(--ease-in);"
                data-slide-id="default"
              >
                {{ default_media }}
              </div>
            {%- else -%}
              {{ default_media }}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="sticky-image-with-text__content-col w-full col-1025-remaining flex">
        <carousel-mobile
          class="sticky-image-with-text__content sticky-image-with-text__content--image-{{ section_st.image_desktop_position }} w-full dis_scroll flex column row-gap gap{% if section_st.enable_carousel_mobile %} carousel-mb{% if section_st.items_per_row == 1.5 %} overflow-visible-mb{% endif %}{% endif %}"
          data-enable-carousel-mobile="{{ section_st.enable_carousel_mobile }}"
          data-mobile="{{ section_st.items_per_row }}"
          data-spacing="{{ column_gap_mb }}"
          data-show-pagination="true"
          data-mobile-screen="767"
          style="{{ content_style | strip | strip_newlines }}"
        >
          {% content_for 'blocks' %}
        </carousel-mobile>
      </div>
    </div>
  </div>
</sticky-image-with-text>
{%- render 'section-divider',
  position: 'bottom',
  style: section_st.divider_bottom,
  color_scheme: section_st.color_scheme,
  enabled: section_st.show_divider
-%}

<script src="{{ 'section-sticky-image-with-text.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.sticky_image_with_text.name",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "_group-text-sticky"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.sticky_image_with_text.how_to_use"
    },
    {
      "type": "header",
      "content": "t:sections.all.general"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "fix_width",
          "label": "t:sections.all.layout.fix_width"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.layout.stretch_width"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.layout.full_width"
        }
      ],
      "default": "fix_width",
      "label": "t:sections.all.layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.info",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_header.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.content_setting.subheading.label"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:sections.all.content_setting.heading.label"
    },
    {
      "type": "checkbox",
      "id": "drawn_underline",
      "default": true,
      "label": "t:sections.all.content_setting.drawn_underline.label",
      "info": "t:sections.all.content_setting.heading.info"
    },
    {
      "type": "select",
      "id": "drawn_underline_type",
      "label": "t:sections.all.content_setting.drawn_underline.type",
      "default": "squiggle_underline",
      "visible_if": "{{ section.settings.drawn_underline != false }}",
      "options": [
        {
          "value": "simple_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.simple_underline"
        },
        {
          "value": "curve_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.curve_underline"
        },
        {
          "value": "squiggle_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.squiggle_underline"
        }
      ]
    },
    {
      "type": "color",
      "id": "drawn_underline_color",
      "label": "t:sections.all.content_setting.drawn_underline.color",
      "default": "#FFB005",
      "alpha": true,
      "visible_if": "{{ section.settings.drawn_underline != false }}"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.all.content_setting.description.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "large",
          "label": "t:sections.all.content_header.heading_size.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.all.content_header.heading_size.options__2.label"
        },
        {
          "value": "small",
          "label": "t:sections.all.content_header.heading_size.options__3.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.all.content_header.heading_size.label"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.text_alignment.alignment"
    },
    {
      "type": "header",
      "content": "t:sections.all.image.label"
    },
    {
      "type": "checkbox",
      "id": "change_image_on_scroll",
      "label": "t:sections.sticky_image_with_text.settings.change_image_on_scroll.label",
      "info": "t:sections.sticky_image_with_text.settings.change_image_on_scroll.info",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label",
      "visible_if": "{{ section.settings.change_image_on_scroll != true }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.all.image.aspect_ratio.adapt"
        },
        {
          "value": "square",
          "label": "t:sections.all.image.aspect_ratio.options__1"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.image.aspect_ratio.options__2"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.image.aspect_ratio.options__3"
        }
      ],
      "default": "adapt",
      "label": "t:sections.all.image.aspect_ratio.label"
    },
    {
      "type": "range",
      "id": "desktop_image_width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50,
      "label": "t:sections.all.image.width",
      "info": "t:sections.all.image.info_width"
    },
    {
      "type": "select",
      "id": "image_desktop_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.image.desktop_position.left"
        },
        {
          "value": "right",
          "label": "t:sections.all.image.desktop_position.right"
        }
      ],
      "default": "left",
      "label": "t:sections.all.image.desktop_position.label",
      "info": "t:sections.all.image.desktop_position.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_setting.label"
    },
    {
      "type": "select",
      "id": "column_gap",
      "options": [
        {
          "value": "no_gap",
          "label": "t:sections.all.padding.column_gap.no_gap"
        },
        {
          "value": "small",
          "label": "t:sections.all.padding.column_gap.small"
        },
        {
          "value": "medium",
          "label": "t:sections.all.padding.column_gap.medium"
        },
        {
          "value": "large",
          "label": "t:sections.all.padding.column_gap.large"
        },
        {
          "value": "x_large",
          "label": "t:sections.all.padding.column_gap.x_large"
        }
      ],
      "default": "large",
      "label": "t:sections.all.padding.column_gap.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.mobile_options.label"
    },
    {
      "type": "checkbox",
      "id": "hide_image_mobile",
      "label": "t:sections.sticky_image_with_text.settings.hide_image_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_carousel_mobile",
      "label": "t:sections.all.carousel.enable_carousel_mobile.label",
      "default": true
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "t:sections.all.items.items_per_row",
      "min": 1,
      "max": 2,
      "step": 0.5,
      "default": 1,
      "visible_if": "{{ section.settings.enable_carousel_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.section_divider_heading"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.all.divider.show_divider",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_top",
      "label": "t:sections.all.divider.top",
      "info": "t:sections.all.divider.top_info",
      "options": [
        { "value": "none", "label": "t:sections.all.divider.none" },
        { "value": "line", "label": "t:sections.all.divider.line" },
        { "value": "wave", "label": "t:sections.all.divider.wave" },
        { "value": "curve-out", "label": "t:sections.all.divider.curve_out" },
        { "value": "curve-in", "label": "t:sections.all.divider.curve_in" }
      ],
      "default": "line",
      "visible_if": "{{ section.settings.show_divider }}"
    },
    {
      "type": "select",
      "id": "divider_bottom",
      "label": "t:sections.all.divider.bottom",
      "info": "t:sections.all.divider.bottom_info",
      "options": [
        { "value": "none", "label": "t:sections.all.divider.none" },
        { "value": "line", "label": "t:sections.all.divider.line" },
        { "value": "wave", "label": "t:sections.all.divider.wave" },
        { "value": "curve-out", "label": "t:sections.all.divider.curve_out" },
        { "value": "curve-in", "label": "t:sections.all.divider.curve_in" }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.show_divider }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.sticky_image_with_text.name",
      "category": "t:sections.group.banners",
      "settings": {
        "subheading": "Plant-Powered Care",
        "heading": "<p>Purposeful <em>ingredients</em></p>",
        "heading_size": "medium",
        "content_alignment": "center"
      },
      "blocks": [
        {
          "type": "_group-text-sticky",
          "settings": {
            "text_alignment": "start",
            "text_alignment_mobile": "start",
            "padding_content_inline": 0,
            "padding_content_block": 0
          },
          "blocks": [
            {
              "type": "image-media",
              "settings": {
                "border_radius_type": "rounded",
                "image_width": 120,
                "image_width_mb": 100
              }
            },
            {
              "type": "subheading",
              "settings": {
                "subheading": "Soothing | Antioxidant"
              }
            },
            {
              "type": "heading",
              "settings": {
                "heading": "<p>Centella Extract</p>"
              }
            },
            {
              "type": "description",
              "settings": {
                "description": "<p>Madecassoside and asiaticoside in centella help calm redness and support the skin barrier while its antioxidant compounds help neutralize free radicals.</p>"
              }
            },
            {
              "type": "list_tag",
              "settings": {
                "tags": "Centella Asiatica | Hydrating | Plant-Based"
              }
            }
          ]
        },
        {
          "type": "_group-text-sticky",
          "settings": {
            "text_alignment": "start",
            "text_alignment_mobile": "start",
            "padding_content_inline": 0,
            "padding_content_block": 0
          },
          "blocks": [
            {
              "type": "image-media",
              "settings": {
                "border_radius_type": "rounded",
                "image_width": 120,
                "image_width_mb": 100
              }
            },
            {
              "type": "subheading",
              "settings": {
                "subheading": "Moisturize | Firm and Smooth"
              }
            },
            {
              "type": "heading",
              "settings": {
                "heading": "<p>Hyaluronic Acid</p>"
              }
            },
            {
              "type": "description",
              "settings": {
                "description": "<p>Multi-molecular-weight hyaluronic acid helps draw and hold water at multiple depths of the epidermis, leaving skin plump and comfortable.</p>"
              }
            },
            {
