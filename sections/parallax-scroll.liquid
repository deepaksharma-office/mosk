      "info": "t:sections.all.colors.info",
      "default": "default-color-scheme"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "t:sections.parallax-scroll.settings.card_width.label",
      "info": "t:sections.parallax-scroll.settings.card_width.info",
      "min": 320,
      "max": 720,
      "step": 4,
      "unit": "px",
      "default": 564
    },
    {
      "type": "header",
      "content": "t:sections.all.content_header.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.content_setting.subheading.label",
      "default": "Purity Philosophy"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:sections.all.content_setting.heading.label",
      "default": "<p>Pure Beauty<br>Chosen <em>With Care</em></p>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.content_header.heading_size.label",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "t:sections.all.content_header.heading_size.options__1.label" },
        { "value": "h2", "label": "t:sections.all.content_header.heading_size.options__2.label" },
        { "value": "h3", "label": "t:sections.all.content_header.heading_size.options__3.label" }
      ]
    },
    {
      "type": "checkbox",
      "id": "drawn_underline",
      "default": true,
      "label": "t:sections.all.content_setting.drawn_underline.label",
      "info": "t:sections.all.content_setting.heading.info"
    },
    {
      "type": "select",
      "id": "drawn_underline_type",
      "label": "t:sections.all.content_setting.drawn_underline.type",
      "default": "squiggle_underline",
      "visible_if": "{{ section.settings.drawn_underline != false }}",
      "options": [
        {
          "value": "simple_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.simple_underline"
        },
        { "value": "curve_underline", "label": "t:sections.all.content_setting.drawn_underline.value.curve_underline" },
        {
          "value": "squiggle_underline",
          "label": "t:sections.all.content_setting.drawn_underline.value.squiggle_underline"
        }
      ]
    },
    {
      "type": "color",
      "id": "drawn_underline_color",
      "label": "t:sections.all.content_setting.drawn_underline.color",
      "default": "#FFB005",
      "alpha": true,
      "visible_if": "{{ section.settings.drawn_underline != false }}"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.all.content_setting.description.label",
      "default": "<p>Beauty should feel simple, honest, and easy to trust. Every detail brings clarity and ease to everyday rituals. ☘️ </p>"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_setting.button_label.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.all.content_setting.button_label.label",
      "info": "t:sections.all.content_setting.button_label.info",
      "default": "Our philosophy"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.content_setting.first_button_label.link",
      "info": "t:sections.parallax-scroll.settings.button_link.info"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "t:sections.all.content_setting.button_type.label",
      "info": "t:sections.parallax-scroll.settings.button_type.info",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "t:sections.all.content_setting.button_type.primary.label" },
        { "value": "outline", "label": "t:sections.all.content_setting.button_type.outline.label" },
        { "value": "link", "label": "t:sections.all.content_setting.button_type.link.label" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.mobile_options.label"
    },
    {
      "type": "checkbox",
      "id": "hide_description_on_mobile",
      "label": "t:sections.all.content_setting.description.hide_on_mobile.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.section_divider_heading"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.all.divider.show_divider",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_top",
      "label": "t:sections.all.divider.top",
      "info": "t:sections.all.divider.top_info",
      "options": [
        { "value": "none", "label": "t:sections.all.divider.none" },
        { "value": "line", "label": "t:sections.all.divider.line" },
        { "value": "wave", "label": "t:sections.all.divider.wave" },
        { "value": "curve-out", "label": "t:sections.all.divider.curve_out" },
        { "value": "curve-in", "label": "t:sections.all.divider.curve_in" }
      ],
      "default": "line",
      "visible_if": "{{ section.settings.show_divider }}"
    },
    {
      "type": "select",
      "id": "divider_bottom",
      "label": "t:sections.all.divider.bottom",
      "info": "t:sections.all.divider.bottom_info",
      "options": [
        { "value": "none", "label": "t:sections.all.divider.none" },
        { "value": "line", "label": "t:sections.all.divider.line" },
