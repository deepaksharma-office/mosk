{{ 'parallax-scroll.css' | asset_url | stylesheet_tag }}
<script src="{{ 'parallax-scroll.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_st = section.settings
  assign scroll_animation = settings.scroll_animation
  assign heading = section_st.heading
  assign drawn_underline = section_st.drawn_underline
  assign drawn_underline_color = section_st.drawn_underline_color
  assign drawn_underline_type = section_st.drawn_underline_type | default: 'squiggle_underline'
  assign card_width = section_st.card_width | default: 564

  if drawn_underline
    assign scroll_animation = 'disable'
  endif
-%}

{%- capture section_style -%}
  --section-pt: {{ section_st.padding_top }};
  --section-pb: {{ section_st.padding_bottom }};
  --parallax-scroll-card-width: {{ card_width }}px;
{%- endcapture -%}

{%- render 'section-divider', position: 'top', style: section_st.divider_top, color_scheme: section_st.color_scheme, enabled: section_st.show_divider -%}
<section
  class="section section__parallax-scroll color-{{ section_st.color_scheme }} gradient{% if section_st.show_divider and section_st.divider_top == 'line' %} border-top{% endif %}{% if section_st.show_divider and section_st.divider_bottom == 'line' %} border-bottom{% endif %}"
  style="{{ section_style | strip | strip_newlines }}"
>
  <div class="full-width parallax-scroll__width relative">
    <parallax-scroll
      class="parallax-scroll block relative{% if section_st.hide_description_on_mobile %} parallax-scroll--hide-description-mobile{% endif %}"
    >
      <div class="parallax-scroll__runway relative" data-parallax-scroll-runway>
        <div class="parallax-scroll__pin relative grid w-full" data-parallax-scroll-pin>
          <div class="parallax-scroll__header relative grid w-full text-center" data-parallax-scroll-header>
            <div
              class="parallax-scroll__header-content max-w-custom mx-auto w-full px-sp-5"
              style="--max-width: 58rem;"
              data-parallax-scroll-header-content
            >
              {%- if section_st.subheading != blank -%}
                {% if scroll_animation != 'disable' %}
                  <motion-effect data-animate="fade-up" data-animate-delay="50" class="block">
                {% endif %}
                <div class="section-subheading h7 mb-sp-1 mb-md-sp-2 subheading_weight fs-big-2">
                  {{ section_st.subheading }}
                </div>
                {% if scroll_animation != 'disable' %}
                  </motion-effect>
                {% endif %}
              {%- endif -%}

              {%- if heading != blank -%}
                {% if scroll_animation != 'disable' or drawn_underline %}
                  <motion-effect
                    data-animate="{% if scroll_animation != 'disable' %}fade-up{% else %}highlighted-text{% endif %}"
                    data-animate-delay="100"
                    class="block"
                  >
                {% endif %}
                <h2 class="section-heading {{ section_st.heading_size }}">
                  {% if drawn_underline %}
                    {%- capture squiggle_svg_1 -%}
                    <svg viewBox="0 0 184 26" fill="none"><use href="#squiggle-svg-1" /></svg>
                  {%- endcapture -%}
                    {%- capture squiggle_svg_2 -%}
                    <svg viewBox="0 0 186 24" fill="none"><use href="#squiggle-svg-2" /></svg>
                  {%- endcapture -%}
                    {%- capture squiggle_svg_3 -%}
                    <svg viewBox="0 0 186 24" fill="none"><use href="#squiggle-svg-3" /></svg>
                  {%- endcapture -%}
                    {%- capture squiggle_svg_4 -%}
                    <svg viewBox="0 0 220 20" fill="none"><use href="#squiggle-svg-4" /></svg>
                  {%- endcapture -%}
                    {%- capture squiggle_svg_5 -%}
                    <svg viewBox="0 0 140 24" fill="none" role="presentation" preserveAspectRatio="none"><use href="#squiggle-svg-5" /></svg>
                  {%- endcapture -%}
                    {%- assign parts = heading | split: '<em>' -%}
                    {%- assign em_count = parts | size | minus: 1 -%}

                    {%- for i in (1..em_count) -%}
                      {%- assign chunk = parts[i] | default: '' -%}
                      {%- assign text = chunk | split: '</em>' | first | strip_html | strip -%}
                      {%- assign len_text = text | size -%}
                      {%- capture open_em -%}
                      {%- liquid
                        if drawn_underline_type == 'simple_underline'
                          assign svg = squiggle_svg_4 | append: '</em>'
                        elsif drawn_underline_type == 'curve_underline'
                          assign svg = squiggle_svg_5 | append: '</em>'
                        else
                          if len_text <= 4
                            assign svg = squiggle_svg_1 | append: '</em>'
                          elsif len_text <= 6
                            assign svg = squiggle_svg_2 | append: '</em>'
                          else
                            assign svg = squiggle_svg_3 | append: '</em>'
                          endif
                        endif
                      -%}
                      <em class="highlighted-text relative inline-flex{% if drawn_underline_type == 'simple_underline' %} simple_underline{% endif %} {{ drawn_underline_type }} not-italic" style="--animate-color: {{ drawn_underline_color }}">{{ svg }}</em>
                    {%- endcapture -%}
                      {%- assign open_em = open_em | remove: '</em>' -%}
                      {%- assign heading = heading | replace_first: '<em>', open_em -%}
                    {%- endfor -%}
                  {% endif %}
                  {{- heading -}}
                </h2>
                {% if scroll_animation != 'disable' or drawn_underline %}
                  </motion-effect>
                {% endif %}
              {%- endif -%}

              {%- if section_st.description != blank -%}
                {% if scroll_animation != 'disable' %}
                  <motion-effect data-animate="fade-up" data-animate-delay="150" class="block">
                {% endif %}
                <div class="section-description prose mt-sp-3 mt-1025-40">
                  {{ section_st.description }}
                </div>
                {% if scroll_animation != 'disable' %}
                  </motion-effect>
                {% endif %}
              {%- endif -%}
            </div>
          </div>
          <div
            class="parallax-scroll__hint absolute z-4 fs-small column align-center heading-color heading_weight w-full gap-sp-1 content-center hidden"
            data-parallax-scroll-hint
          >
            <p class="lh-global fs-small heading-color">
              {{ 'sections.parallax_image.additional' | t }}
            </p>
            <span class="parallax-scroll__hint-icon inline-flex content-center heading-color" aria-hidden="true">
              <svg
                class="block"
                width="8"
                height="14"
                viewBox="0 0 6 11"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <use href="#icon-next"></use>
              </svg>
            </span>
          </div>
        </div>

        <div class="container parallax-scroll__cards flex column" role="list" data-parallax-scroll-cards>
          {% content_for 'blocks' %}
        </div>

        {%- if section_st.button_label != blank -%}
          <div
            class="parallax-scroll__footer relative z-4 flex justify-center w-full"
            data-parallax-scroll-footer
          >
            <a
              {% if section_st.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section_st.button_link }}"
              {% endif %}
              aria-label="{{ section_st.button_label | escape }}"
              class="pointer text-center btn-{{ section_st.button_type }}{% if section_st.button_type == 'link' %} align-self-center border-animation z-2{% else %} btn min-w-md-custom w-md-auto max-w-100{% endif %}"
              {% if section_st.button_type != 'link' %}
                style="--width: 35rem;"
              {% endif %}
            >
              {{ section_st.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </parallax-scroll>
  </div>
</section>
{%- render 'section-divider', position: 'bottom', style: section_st.divider_bottom, color_scheme: section_st.color_scheme, enabled: section_st.show_divider -%}

{% schema %}
{
  "name": "t:sections.parallax-scroll.name",
  "tag": "section",
  "class": "section section-parallax-scroll",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 7,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.parallax-scroll.how_to_use"
