    "faqs_zTt7cD": {
      "type": "faqs",
      "blocks": {
        "item_faq_zaAR4p": {
          "type": "_item-faq",
          "settings": {
            "question": "Is it suitable for sensitive skin?",
            "answer": "<p>Yes. Our formulas are thoughtfully developed with gentle, skin-friendly ingredients that are suitable for most skin types, including sensitive skin. If you have highly reactive skin or known allergies, we recommend performing a patch test before first use.</p>"
          },
          "blocks": {}
        },
        "item_faq_X4K6XP": {
          "type": "_item-faq",
          "settings": {
            "question": "How do I build a routine?",
            "answer": "<p>Start with the basics: cleanse, moisturize, and apply sunscreen in the morning; cleanse and apply a nourishing treatment at night. Once your skin adjusts, you can layer in a serum or targeted treatment based on your specific needs. Check out our Routine Guide for more detailed advice based on your skin type.</p>"
          },
