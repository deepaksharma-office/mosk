{%- doc -%}
  Outputs the wave divider mask tiles as CSS variables, built from one wave path.

  @example
  {% render 'divider-wave-mask' %}
{%- enddoc -%}
{%- liquid
  assign wave_path = "<path d='M0 0c23.6 0 25.66 7.91 49.26 7.91s25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91 25.66 7.91 49.26 7.91 25.66-7.91 49.26-7.91h1V11H0Z'/>"
  assign svg_open = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1970.4 10' preserveAspectRatio='none'>"
  assign wave_top = svg_open | append: wave_path | append: '</svg>' | replace: '<', '%3C' | replace: '>', '%3E'
  assign wave_bottom = svg_open | append: "<g transform='matrix(1 0 0 -1 0 10)'>" | append: wave_path | append: '</g></svg>' | replace: '<', '%3C' | replace: '>', '%3E'
-%}
:root {
  --divider-wave-top: url("data:image/svg+xml,{{ wave_top }}");
  --divider-wave-bottom: url("data:image/svg+xml,{{ wave_bottom }}");
}
