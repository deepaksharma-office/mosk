{% doc %}
  Renders the voice search (speech-to-text) button for a search form.
  The button stays hidden until `voice-search.js` confirms browser support.
  Must be rendered inside the search `<form>`, after the search input.

  @param {string} [classes] - Utility classes controlling placement.
  @param {string} [filled_class] - Utility class added while the search input has a value.
  @param {number} [size] - Icon size in pixels. Defaults to 22.
  @param {boolean} [focus_input] - Focuses the search input when listening starts.

  @example
  {% render 'voice-search-button', classes: 'absolute inset-y-0 z-3 right-24 right-1025-26', filled_class: 'me-sp-8' %}
{% enddoc %}

{%- liquid
  assign icon_size = size | default: 22
-%}
<voice-search
  class="hidden align-center{% if classes != blank %} {{ classes }}{% endif %}"
  {% if focus_input %}
    data-focus-input
  {% endif %}
  {% if filled_class != blank %}
    data-filled-class="{{ filled_class }}"
  {% endif %}
  data-label-start="{{ 'general.search.voice_search' | t | escape }}"
  data-label-stop="{{ 'general.search.voice_listening' | t | escape }}"
>
  <button
    type="button"
    class="btn-reset inline-flex content-center pointer heading-color transition"
    aria-label="{{ 'general.search.voice_search' | t | escape }}"
    aria-pressed="false"
  >
    <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 22 22" fill="none" aria-hidden="true">
      <path d="M11 14.2083C13.0258 14.2083 14.6667 12.5675 14.6667 10.5417V5.5C14.6667 3.47417 13.0258 1.83333 11 1.83333C8.97417 1.83333 7.33333 3.47417 7.33333 5.5V10.5417C7.33333 12.5675 8.97417 14.2083 11 14.2083Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M3.9875 8.84583V10.4042C3.9875 14.2725 7.13167 17.4167 11 17.4167C14.8683 17.4167 18.0125 14.2725 18.0125 10.4042V8.84583" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M9.72583 5.89417C10.5508 5.59167 11.4492 5.59167 12.2742 5.89417" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M10.2667 7.8375C10.7525 7.70917 11.2567 7.70917 11.7425 7.8375" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M11 17.4167V20.1667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</voice-search>
