{% doc %}
  Renders a search history list and the templates used to populate it.

  @param {string} history_id - Unique ID for the search history instance.
  @param {string} classes - Utility classes controlling placement and spacing.
  @param {string} [max_width] - Optional maximum width for the history container.
  @param {boolean} [search_panel_popup] - Aligns the clear action for the popup layout.
{% enddoc %}

<div
  id="{{ history_id }}"
  class="{{ classes }}"
  data-search-history
  {% if max_width != blank %}
    style="--max-width: {{ max_width }};"
  {% endif %}
>
  <ul class="history-list list-unstyled flex gap-sp-2 wrap"></ul>
  <template data-history-item-template>
    <li>
      <a href="#" class="inline-flex gap-6 px-sp-3 py-sp-1 bg-secondary rounded-30 content-center"
        ><span class="icon flex content-center">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6.71246 12.1971C9.74224 12.1971 12.1984 9.74102 12.1984 6.71124C12.1984 3.68146 9.74224 1.22534 6.71246 1.22534C3.68268 1.22534 1.22656 3.68146 1.22656 6.71124C1.22656 9.74102 3.68268 12.1971 6.71246 12.1971Z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12.7736 12.7743L11.6187 11.6194" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg></span
        ><span class="text fs-small"></span
      ></a>
    </li>
  </template>
  <template data-history-clear-template>
    <li class="history-clear{% if search_panel_popup %} ms-auto{% endif %}">
      <button
        type="button"
        class="clear-history-btn btn-reset bg-secondary rounded-50 w-custom h-custom flex content-center pointer button-hover-zoom will-change"
        style="--width: 31px;--height: 31px;"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 20 20"
          fill="none"
          class="icon-zoom transition-short will-change text-color"
        >
          <use href="#icon-trash-cart"/>
        </svg>
      </button>
    </li>
  </template>
</div>
