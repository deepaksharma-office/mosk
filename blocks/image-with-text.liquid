{%- liquid
  assign block_st = block.settings
  assign column_gap_desktop = 0
  assign column_gap_mobile = 0

  if block_st.column_gap == 'x-large'
    assign column_gap_desktop = 100
    assign column_gap_mobile = 16
  elsif block_st.column_gap == 'large'
    assign column_gap_desktop = 32
    assign column_gap_mobile = 16
  elsif block_st.column_gap == 'medium'
    assign column_gap_desktop = 24
    assign column_gap_mobile = 12
  elsif block_st.column_gap == 'small'
    assign column_gap_desktop = 16
    assign column_gap_mobile = 8
  endif

  assign radius_image_class = 'rounded'
  assign radius_content_class = 'rounded'
  if column_gap_desktop == 0
    if block_st.image_desktop_position == 'left'
      assign radius_image_class = 'rounded-1025-left rounded-top-mb'
      assign radius_content_class = 'rounded-1025-right rounded-bottom-mb'
    else
      assign radius_image_class = 'rounded-1025-right rounded-top-mb'
      assign radius_content_class = 'rounded-1025-left rounded-bottom-mb'
    endif
  endif

  assign padding_content_class = ''
  if block_st.padding_content_inline > 20
    assign padding_content_class = padding_content_class | append: ' px-custom'
  else
    assign padding_content_class = padding_content_class | append: ' x-min-value'
  endif
  if block_st.padding_content_block > 24
    assign padding_content_class = padding_content_class | append: ' py-custom'
  else
    assign padding_content_class = padding_content_class | append: ' y-min-value'
  endif

  assign ratio = '3/4'
  assign ratio_mobile = '3/4'
  if block_st.image_ratio != 'adapt'
    case block_st.image_ratio
      when 'square'
        assign ratio = '1/1'
        assign ratio_mobile = '1/1'
      when 'landscape'
        assign ratio = '4/3'
        assign ratio_mobile = '4/3'
      when 'portrait'
        assign ratio = '3/4'
        assign ratio_mobile = '3/4'
    endcase
  elsif block_st.image != blank
    assign ratio = block_st.image.aspect_ratio
    assign ratio_mobile = ratio
    if block_st.image_mobile != blank
      assign ratio_mobile = block_st.image_mobile.aspect_ratio
    endif
  endif

  if request.visual_preview_mode
    assign radius_image_class = 'rounded-1025-left rounded-top-mb'
    assign radius_content_class = 'rounded-1025-right rounded-bottom-mb'
    assign padding_content_class = 'p-sp-5'
    assign ratio = '4/3'
    assign ratio_mobile = '4/3'
  endif
-%}

{%- capture block_style -%}
  --space-bottom: {{ block_st.padding_bottom }};--space-top: {{ block_st.padding_top }};--space-left: 0;--space-right: 0;--space-min-left: 0;--space-min-right: 0;
  {%- if block_st.padding_top > 20 -%}--space-min-top: {{ block_st.padding_top | times: 0.67 }};{%- else -%}--space-min-top: {{ block_st.padding_top }};{%- endif -%}
  {%- if block_st.padding_bottom > 20 -%}--space-min-bottom: {{ block_st.padding_bottom | times: 0.67 }};{%- else -%}--space-min-bottom: {{ block_st.padding_bottom }};{%- endif -%}
  --gap: {{ column_gap_mobile }}px;--gap-desktop: {{ column_gap_desktop }}px;--col-width: {{ block_st.desktop_image_width }}%;--padding-inline: {{ block_st.padding_content_inline }};--padding-block: {{ block_st.padding_content_block }};--responsive-min-rate: 0.6;--button-alignment-mobile: {{ block_st.text_alignment_mobile }};--button-alignment: {{ block_st.text_alignment }};
{%- endcapture -%}

<div
  class="flexible-block image-with-text-block group-block--width-{{ block_st.width_block }} group-block--width-mb-{{ block_st.width_block_mobile }} w-full spacing-style size-style switch-slide__mobile{% if request.visual_preview_mode %} bg-white p-sp-5 rounded-5{% endif %}"
  style="{{ block_style | strip | strip_newlines }}{% render 'size-style', settings: block_st, is_group: true %}{% if request.visual_preview_mode %};--width-size-mobile: 500px;--width-size: 1000px;{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="flex wrap gap{% if block_st.image_desktop_position == 'right' %} row-reverse-md{% endif %} w-full">
    <div class="image-with-text__media-item w-full col-1025-w-custom">
      <div
        class="image-with-text__media banner__media {{ radius_image_class }} h-full"
        style="--aspect-ratio-mb: {{ ratio_mobile }};--aspect-ratio: {{ ratio }};"
      >
        {%- liquid
          assign image_alt = 'general.image.image_alt_default' | t
          if block_st.image.alt
            assign image_alt = block_st.image.alt | escape
          endif
        -%}
        {% if block_st.image != blank or block_st.image_mobile != blank %}
          {% render 'responsive-image',
            type: 'other',
            container: 'fluid_container',
            image: block_st.image,
            image_mobile: block_st.image_mobile,
            image_alt: image_alt,
            motion: true,
            animate: 'zoom-out-small'
          %}
        {% else %}
          {% render 'placeholder-render',
            type: 'collection-6',
            class: 'img-placeholder h-full w-full',
            motion: true,
            animate: 'zoom-out-small'
          %}
        {% endif %}
      </div>
    </div>
    <div class="w-full col-1025-remaining flex text-{{ block_st.text_alignment_mobile }} text-md-{{ block_st.text_alignment }}">
      <div
        class="image-with-text__wrapper w-full flex bg-custom {{ radius_content_class }}"
        style="--bg-color-custom: {{ block_st.background_color }};"
      >
        <div class="image-with-text__text-item-inner w-full align-self-{{ block_st.desktop_vertical_alignment }}{{ padding_content_class }}{% if request.visual_preview_mode %} p-40 align-self-center {% endif %}">
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text-block .block__buttons {
    justify-content: var(--button-alignment-mobile);
  }

  @media (min-width: 768px) {
    .image-with-text-block .block__buttons {
      justify-content: var(--button-alignment);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "tag": null,
  "blocks": [
    {
      "type": "subheading"
    },
    {
      "type": "heading"
    },
    {
      "type": "description"
    },
    {
      "type": "button"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.image-with-text.how_to_use"
    },
    {
      "type": "header",
      "content": "t:sections.all.image.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label",
      "info": "t:sections.image-with-text.settings.image_info"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.all.image.mobile_image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.all.image.aspect_ratio.adapt"
        },
        {
          "value": "square",
          "label": "t:sections.all.image.aspect_ratio.options__1"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.image.aspect_ratio.options__2"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.image.aspect_ratio.options__3"
        }
      ],
      "default": "adapt",
      "label": "t:sections.all.image.aspect_ratio.label"
    },
    {
      "type": "range",
      "id": "desktop_image_width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50,
      "label": "t:sections.all.image.width",
      "info": "t:sections.all.image.info_width"
    },
    {
      "type": "select",
      "id": "image_desktop_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.image.desktop_position.left"
        },
        {
          "value": "right",
          "label": "t:sections.all.image.desktop_position.right"
        }
      ],
      "default": "left",
      "label": "t:sections.all.image.desktop_position.label",
      "info": "t:sections.all.image.desktop_position.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_setting.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.image-with-text.settings.background_color",
      "default": "#F3F0E8",
      "alpha": true
    },
    {
      "type": "select",
      "id": "desktop_vertical_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.top"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.middle"
        },
        {
          "value": "end",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.bottom"
        }
      ],
      "default": "center",
      "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.label"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "start",
      "label": "t:sections.all.text_alignment.label"
    },
    {
      "type": "select",
      "id": "column_gap",
      "options": [
        {
          "value": "no_gap",
          "label": "t:sections.all.padding.column_gap.no_gap"
        },
        {
          "value": "small",
          "label": "t:sections.all.padding.column_gap.small"
        },
        {
          "value": "medium",
          "label": "t:sections.all.padding.column_gap.medium"
        },
        {
          "value": "large",
          "label": "t:sections.all.padding.column_gap.large"
        },
        {
          "value": "x-large",
          "label": "t:sections.all.padding.column_gap.x_large"
        }
      ],
      "default": "no_gap",
      "label": "t:sections.all.padding.column_gap.label"
    },
    {
      "type": "range",
      "id": "padding_content_inline",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_inline.label",
      "info": "t:sections.all.padding.padding_inline.info",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_content_block",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_block.label",
      "info": "t:sections.all.padding.padding_block.info",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.custom_section.blocks.settings.size.label"
    },
    {
      "type": "select",
      "id": "width_block",
      "label": "t:sections.custom_section.blocks.settings.size.width.label",
      "default": "fill",
      "options": [
        {
          "value": "fill",
          "label": "t:sections.custom_section.blocks.settings.size.options.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:sections.custom_section.blocks.settings.size.options.options__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_width",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "label": "t:sections.custom_section.blocks.settings.size.width.custom_width.label",
      "visible_if": "{{ block.settings.width_block == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_block_mobile",
      "label": "t:sections.custom_section.blocks.settings.size.mobile_width.label",
      "default": "fill",
      "options": [
        {
          "value": "fill",
          "label": "t:sections.custom_section.blocks.settings.size.options.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:sections.custom_section.blocks.settings.size.options.options__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "label": "t:sections.custom_section.blocks.settings.size.width.custom_width.label",
      "visible_if": "{{ block.settings.width_block_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.mobile_options.label"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "start",
      "label": "t:sections.all.text_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.custom_section.blocks.page.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-with-text.name",
      "category": "t:sections.group.blocks.layout",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "description"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
