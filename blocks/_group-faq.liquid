{% style %}
  #shopify-block-{{ block.id }} .group__faqs-content .shopify-block:first-of-type summary {
    padding-top: 0;
  }
  .block-group__faqs-content .collapsible-row__summary {
    font-family: var(--heading-font);
    font-weight: var(--heading-weight, 600);
    padding-block: var(--sp-4);
  }
  .block-group__faqs-content .collapsible-row__summary .fs-big-2 {
    font-size: var(--h6);
  }
  .block-group__faqs-content .faq_content-inner {
    margin-bottom: var(--sp-4);
  }
  @media (min-width: 1025px) {
    .block-group__faqs-content .collapsible-row__summary {
      padding-block: var(--sp-5);
    }
    .block-group__faqs-content .faq_content-inner {
        margin-bottom: var(--sp-5);
    }
  }
{% endstyle %}

<div
  class="block-group__faqs-content w-full pt-custom pb-custom"
  style="--space-top: {{ block.settings.padding_top }}; --space-bottom: {{ block.settings.padding_bottom }};"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:sections.faq.name",
  "blocks": [
    {
      "type": "_item-faq"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:sections.custom_section.blocks.page.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "category": "t:sections.group.blocks.basic",
      "blocks": [
        {
          "type": "_item-faq"
        },
        {
          "type": "_item-faq"
        },
        {
          "type": "_item-faq"
        },
        {
          "type": "_item-faq"
        }
      ]
    }
  ]
}
{% endschema %}
