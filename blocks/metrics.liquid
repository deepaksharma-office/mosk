{% liquid
  assign section_st = section.settings
  assign block_st = block.settings
  assign content_alignment = section_st.text_alignment
  assign text_alignment_mobile = section_st.text_alignment_mobile | default: content_alignment
  assign metrics_gap = 60
  assign metrics_gap_mobile = 32
%}
{% capture style %}
--space-bottom: {{ block_st.padding_bottom }};--space-top: {{ block_st.padding_top }};
--gap: {{ metrics_gap_mobile }}px;--gap-desktop: {{ metrics_gap }}px;--row-gap: 8px;
{% endcapture %}

<div
  class="block-metrics mb-custom mt-custom{% if block_st.padding_bottom > 10 %} mb_auto-rsp{% endif %}{% if block_st.padding_top > 10 %} mt_auto-rsp{% endif %} w-full text-{{ text_alignment_mobile }} text-md-{{ content_alignment }}"
  style="{{ style | strip | strip_newlines }}"
  {{ block.shopify_attributes }}
>
  <div class="block-metrics__items justify_block flex wrap gap justify-content-{{ text_alignment_mobile }} flex-md-{{ content_alignment }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.all.content_setting.metrics.label",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.custom_section.blocks.page.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "_metric-item"
    }
  ],
  "presets": [
    {
      "name": "t:sections.all.content_setting.metrics.label",
      "category": "t:sections.group.blocks.basic",
      "blocks": [{ "type": "_metric-item" }, { "type": "_metric-item" }, { "type": "_metric-item" }]
    }
  ]
}
{% endschema %}
