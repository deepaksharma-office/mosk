{%- liquid
  assign metafield_path = block.settings.metafield | default: 'custom.highlights' | strip
  assign metafield_parts = metafield_path | split: '.'
  assign metafield_namespace = metafield_parts[0] | default: 'custom'
  assign metafield_key = metafield_parts[1] | default: 'highlights'
  assign highlights_metafield = closest.product.metafields[metafield_namespace][metafield_key]
-%}
{%- if closest.product != blank -%}
  {%- if highlights_metafield.value -%}
    <ul
      class="list-unstyled flex wrap gap-sp-4 gap-1025-sp-8 row-gap-sp-4"
    >
      {%- for highlights in highlights_metafield.value -%}
        <li class="flex column fs-small" style="--width:6.5rem;">
          {% # theme-check-disable %}
          {% assign image_alt = highlights.icon.alt | default: closest.product.title | escape %}
          {% # theme-check-enable %}
          {%- if highlights.icon -%}
            {%
              render 'responsive-image',
              type: 'other',
              image: highlights.icon,
              image_alt: image_alt,
              class: 'rounded w-custom max-w-100'
            %}
          {% endif %}
          {%- if highlights.title -%}
            <div class="highlights-text heading-color mt-sp-2 w-full text-size">
              {{ highlights.title }}
            </div>
          {% endif %}
        </li>
      {%- endfor -%}
    </ul>
  {% elsif request.design_mode %}
    {%- render 'editor-metafield-hint', id: 'highlights', source: metafield_path -%}
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "t:sections.all.product_setting.highlights.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.all.product_setting.highlights.description"
    },
    {
      "type": "text",
      "id": "metafield",
      "label": "t:sections.all.metafield.highlights.label",
      "info": "t:sections.all.metafield.highlights.info",
      "default": "custom.highlights"
    }
  ],
  "class": "block-product__highlights my-custom slideIn-animate",
  "presets": [{ "name": "t:sections.all.product_setting.highlights.name" }]
}
{% endschema %}
