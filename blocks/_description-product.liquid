{%- liquid
  assign metafield_path = block.settings.metafield | default: 'custom.short_description' | strip
  assign metafield_parts = metafield_path | split: '.'
  assign metafield_namespace = metafield_parts[0] | default: 'custom'
  assign metafield_key = metafield_parts[1] | default: 'short_description'
  assign short_description = closest.product.metafields[metafield_namespace][metafield_key]
-%}
{%- if closest.product != blank -%}
  {%- if short_description != blank -%}
    {{ short_description }}
  {%- elsif closest.product.description != blank or request.design_mode == false or request.visual_preview_mode -%}
    {{ closest.product.description }}
  {% else %}
    {%- assign hint_source = metafield_path | append: ' → product.description' -%}
    {%- render 'editor-metafield-hint', id: 'description', source: hint_source -%}
  {% endif %}
{%- else -%}
  {{ 'onboarding.default_description' | t }}
{% endif %}
{% schema %}
{
  "name": "t:sections.all.content_setting.description.label",
  "class": "block-product__description my-custom rte slideIn-animate",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.all.content_setting.description.description"
    },
    {
      "type": "text",
      "id": "metafield",
      "label": "t:sections.all.metafield.short_description.label",
      "info": "t:sections.all.metafield.short_description.info",
      "default": "custom.short_description"
    }
  ],
  "presets": [{ "name": "t:sections.all.content_setting.description.label" }]
}
{% endschema %}
